# Local: copy to .env.  Hosted (Vercel): add these under Settings → Environment Variables.

# ── Required ─────────────────────────────────────────────────────────────
# Your password for /admin (approve requests, manage members).
ADMIN_PASSWORD=
# 32+ random characters. Signs logins and encrypts members' Asana tokens.
# Generate one:  openssl rand -hex 32     (changing it logs everyone out and
# members must reconnect Asana)
SESSION_SECRET=

# ── Email: daily reports + access-request pings ──────────────────────────
# Preferred: a Gmail account made for Tracket (free, ~500 emails/day, any recipient).
# Turn on 2-Step Verification on it, then create an App password (16 letters).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Where access requests are sent.
ADMIN_EMAIL=
# Fallback: resend.com. Without a verified domain it only delivers to your own address.
# RESEND_API_KEY=
# RESEND_FROM="Tracket <hello@yourdomain.com>"
# Telegram: create a bot with @BotFather, then get your chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Database (hosted) ────────────────────────────────────────────────────
# Preferred: Turso (free: 500M reads / 10M writes a month). Added automatically
# when you connect Turso in Vercel → Storage.
# TURSO_DATABASE_URL=libsql://…turso.io
# TURSO_AUTH_TOKEN=
# Older: Upstash Redis (free: 500K commands a month). If both are set, Tracket
# uses Turso and copies everything over from Upstash once, on the first request.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Optional: Bearer token a scheduler may send to /api/cron (the admin panel's URL works without it)
# CRON_SECRET=

# ── Optional ─────────────────────────────────────────────────────────────
# TRACKET_TZ=UTC      # fallback time zone if a browser doesn't send one
# PORT=3000           # local server port
