# Copy this file to .env (local) — on Vercel, add these as Environment Variables instead.

# Required. Asana → profile photo → Settings → Apps → Developer apps → "Create new token".
ASANA_PAT=

# Required when hosted, optional locally. Any long password; it locks the dashboard
# and is the TRACKET_KEY you paste into the userscript.
TRACKET_SECRET=

# Optional. Fallback time zone if the browser doesn't send one (e.g. Asia/Kolkata).
# TRACKET_TZ=UTC

# Hosted only — added automatically when you connect Upstash Redis in Vercel → Storage.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
